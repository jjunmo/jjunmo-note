{
  "name": "jjunmo-note",
  "version": "0.1.0",
  "description": "Local-first markdown knowledge base with wikilinks, backlinks, graph view and live preview",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "dist": "electron-vite build && electron-builder",
    "test:e2e": "node test/e2e/smoke.mjs"
  },
  "keywords": [
    "markdown",
    "notes",
    "wikilinks",
    "electron",
    "codemirror",
    "knowledge-base"
  ],
  "author": "jjunmo",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@replit/codemirror-vim": "^6.4.0",
    "d3-force": "^3.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "lucide": "^1.56.0",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false,
    "fsevents": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jjunmo/jjunmo-note.git"
  },
  "homepage": "https://github.com/jjunmo/jjunmo-note",
  "build": {
    "appId": "com.jjunmo.note",
    "productName": "jjunmo note",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
